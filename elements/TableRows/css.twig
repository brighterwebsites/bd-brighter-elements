%%SELECTOR%% {
  {{ macros.spacing_margin_y(design.spacing) }}
  {% if design.table_styles.border_width.style %}
  border-color: {{ design.table_styles.border_color }};
  border-width: {{ design.table_styles.border_width.style }};
  border-style: solid;
  {% endif %}
  border-radius: {{ design.table_styles.border_radius.style }};
}

{{ macros.fancyBackgroundCss('%%SELECTOR%%', design.background, breakpoint, false, true) }}

/* Header */
%%SELECTOR%% thead {
  {{ macros.background(design.table_styles.header_bg) }}
}

%%SELECTOR%% thead .bde-table__text,
%%SELECTOR%% thead .bde-table__cell {
  {{ macros.typography(design.text.headings, globalSettings) }}
  {{ macros.spacing_padding_all(design.table_styles.spacing_padding_all) }}
  {% if design.table_styles.header_align_text == 'Top' %}
  vertical-align: top;
  {% elseif design.table_styles.header_align_text == 'Center' %}
  vertical-align: middle;
  {% elseif design.table_styles.header_align_text == 'Bottom' %}
  vertical-align: bottom;
  {% endif %}
}

/* Cells */
%%SELECTOR%% tbody .bde-table__text,
%%SELECTOR%% tbody .bde-table__cell {
  {% if design.table_styles.border_width.style %}
  border-bottom-style: solid;
  border-bottom-color: {{ design.table_styles.border_color }};
  border-bottom-width: {{ design.table_styles.border_width.style }};
  {% endif %}
  {{ macros.spacing_padding_all(design.table_styles.spacing_padding_all) }}
  {{ macros.typography(design.text.cell_text, globalSettings) }}
  {% if design.table_styles.cell_align_text == 'center' %}
  vertical-align: middle;
  {% elseif design.table_styles.cell_align_text == 'top' %}
  vertical-align: top;
  {% elseif design.table_styles.cell_align_text == 'bottom' %}
  vertical-align: bottom;
  {% endif %}
}

%%SELECTOR%% tbody td:not(:last-child),
%%SELECTOR%% td:not(:last-child) {
  {% if design.table_styles.border_width.style %}
  border-right-style: solid;
  border-right-color: {{ design.table_styles.border_color }};
  border-right-width: {{ design.table_styles.border_width.style }};
  {% endif %}
}

%%SELECTOR%% tbody tr:nth-child(odd) {
  background-color: {{ design.table_styles.odd_rows_bg }};
  transition: background-color 0.5s ease;
}

%%SELECTOR%% tbody tr:nth-child(even) {
  background-color: {{ design.table_styles.even_rows_bg }};
  transition: background-color 0.5s ease;
}

%%SELECTOR%% tbody tr:nth-child(odd):hover {
  background-color: {{ design.table_styles.odd_rows_bg_hover }};
}

%%SELECTOR%% tbody tr:nth-child(even):hover {
  background-color: {{ design.table_styles.even_rows_bg_hover }};
}

{% if content.the_table_tags.table_outer_tags == 'table' %}
{% if content.settings.table_behaviour == 'collapse-row-labels' %}

@media (max-width: 680px) {

%%SELECTOR%% {
  background-color: unset;
  box-shadow: unset;
}

%%SELECTOR%%.bw-collapse-row-labels thead {
  display: none;
}

%%SELECTOR%%.bw-collapse-row-labels tr,
%%SELECTOR%%.bw-collapse-row-labels td {
  display: block;
  width: 100%;
}

%%SELECTOR%%.bw-collapse-row-labels tbody tr {
  margin-bottom: 12px;
  border-color: {{ design.table_styles.border_color }};
  border-bottom-width: {{ design.table_styles.border_width.style }};
  border-bottom-style: solid;
  background-color: {{ design.table_styles.even_rows_bg }};
  box-shadow: unset;
  border-radius: 10px;
}

%%SELECTOR%%.bw-collapse-row-labels tbody tr:nth-child(odd) {
  background-color: {{ design.table_styles.odd_rows_bg }};
}

%%SELECTOR%%.bw-collapse-row-labels td {
  position: relative;
  padding: 10px 12px 10px 45%;
  border-bottom-color: {{ design.table_styles.border_color }};
  border-bottom-width: {{ design.table_styles.border_width.style }};
  border-bottom-style: solid;
  border-radius: 0;
}

%%SELECTOR%%.bw-collapse-row-labels td:nth-child(odd) {
  background-color: {{ design.table_styles.odd_rows_bg }};
}

%%SELECTOR%%.bw-collapse-row-labels td:hover {
  background-color: {{ design.table_styles.odd_rows_bg_hover }};
}

%%SELECTOR%%.bw-collapse-row-labels td:last-child {
  border-bottom: none;
}

%%SELECTOR%%.bw-collapse-row-labels td::before {
  {{ macros.typography(design.text.headings, globalSettings) }}
  content: attr(data-label);
  position: absolute;
  left: 12px;
  top: 10px;
}

}

{% endif %}
{% endif %}

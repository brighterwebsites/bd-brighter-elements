%%SELECTOR%% {
  width: {{ design.wrapper.width.style }};
  background-color: {{ design.wrapper.background }};
  {{ macros.spacing_margin_y(design.spacing) }}
  --bde-transition-duration: {{ design.item.transition_duration.style }};
  gap: {{ design.item.after_item.style }};
}

%%SELECTOR%% .bde-faq__item {
  background-color: {{ design.item.background }};
  border-color: {{ design.borders.border_color }};
  border-width: {{ design.borders.border_width.style }};
  border-radius: {{ design.borders.border_radius.style }};
  padding: {{ design.item.vertical_padding.style }} {{ design.item.horizontal_padding.style }};
}

{% if design.borders.below_only %}
  %%SELECTOR%% .bde-faq__item {
    border-top: none !important;
    border-left: none !important;
    border-right: none !important;
    border-radius: 0 !important;
  }
  %%SELECTOR%% .bde-faq__item:last-child {
    border-bottom: none;
  }
  %%SELECTOR%% {
    gap: 0;
  }
{% endif %}

%%SELECTOR%% .bde-faq__item.is-active {
  background-color: {{ design.item.active_background }};
}

%%SELECTOR%% .bde-faq__item.is-active .bde-faq__title {
  color: {{ design.typography.active_title }};
}

%%SELECTOR%% .bde-faq__item.is-active .bde-faq__icon {
  color: {{ design.item.icon.active_color|default(design.item.icon.color)|default(design.typography.active_title) }};
}

%%SELECTOR%% .bde-faq__icon {
  color: {{ design.item.icon.color|default(design.typography.title.color) }};
  font-size: {{ design.item.icon.size.style }};
}

%%SELECTOR%% .bde-faq__answer-content {
  margin-top: {{ design.item.below_title.style }};
}

%%SELECTOR%% .bde-faq__title {
  {{ macros.typography(design.typography.title, globalSettings) }}
}

%%SELECTOR%% .bde-faq__answer-content {
  {{ macros.typography(design.typography.content, globalSettings) }}
}
